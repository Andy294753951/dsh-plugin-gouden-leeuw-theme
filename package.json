{
  "name": "dsh-plugin-gouden-leeuw-theme",
  "version": "0.1.0",
  "description": "Unofficial Gouden Leeuw moonlit sanctuary theme for the DeepSeek Harness web UI",
  "author": "Andy294753951",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andy294753951/dsh-plugin-gouden-leeuw-theme.git"
  },
  "homepage": "https://github.com/Andy294753951/dsh-plugin-gouden-leeuw-theme#readme",
  "bugs": {
    "url": "https://github.com/Andy294753951/dsh-plugin-gouden-leeuw-theme/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test",
    "check": "npm run build && node --check lib/index.js && node --check lib/client.js && node --test"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "gouden-leeuw",
    "azur-lane"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "scripts",
    "install.ps1",
    "uninstall.ps1",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.5 <0.2.0"
  }
}
